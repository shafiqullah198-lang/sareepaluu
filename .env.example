# ============================================================
# SareePaluu Django Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Django Core ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*, localhost, 127.0.0.1, 0.0.0.0, 10.0.2.2

# --- JWT Token Lifetimes ---
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# --- CORS ---
# In DEBUG mode, all origins are allowed automatically.
# In production, set CORS_ALLOW_ALL_ORIGINS=False and list origins below.
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000,http://10.0.2.2:8000

# --- CSRF ---
# Add all origins that will submit forms/POST requests.
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000,http://10.0.2.2:8000

# --- Physical device / LAN testing ---
# Set this to your development machine's local network IP (e.g., 192.168.1.55).
# Django will automatically add it to CORS_ALLOWED_ORIGINS and CSRF_TRUSTED_ORIGINS.
# Find your IP with: ipconfig (Windows) or ip addr / ifconfig (Linux/Mac).
LOCAL_DEV_IP=
