# =====================================================================
# SareePaluu Mobile App — dart-define Variables
# =====================================================================
# These variables are passed to Flutter at build/run time via
#   flutter run --dart-define=KEY=value
# or
#   flutter build apk --dart-define=KEY=value
#
# You do NOT need a Flutter .env plugin — dart-define is native.
# =====================================================================

# --- API Base URL (optional override) ---
# If set, this ALWAYS wins over the platform auto-detection logic.
# Useful for CI/CD, staging environments, or custom setups.
#
# Example:
#   flutter run --dart-define=API_BASE_URL=http://192.168.18.51:8000/api/v1
#
# Default auto-detection (no override needed for local dev):
#   Android emulator  → http://10.0.2.2:8000/api/v1
#   iOS simulator     → http://localhost:8000/api/v1
#   Chrome / Web      → http://localhost:8000/api/v1
#   Windows desktop   → http://127.0.0.1:8000/api/v1
API_BASE_URL=http://192.168.18.51:8000/api/v1

# --- Physical Device Local IP ---
# Set this to your development machine's LAN IP when testing on a
# real Android/iOS device connected to the same WiFi network.
#
# Find your IP:
#   Windows → ipconfig   (look for IPv4 Address under your WiFi adapter)
#   macOS   → ifconfig   (look for en0 inet)
#   Linux   → ip addr    (look for your WiFi interface)
#
# Example:
#   flutter run --dart-define=LOCAL_IP=192.168.18.51
#
LOCAL_IP=192.168.18.51
